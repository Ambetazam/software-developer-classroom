import java.util.Scanner;

// Create 3 conditions if it rains, sunny, other.

public class Weather{

	public static void main(string[] args){

		Scanner read = new Scanner(System.in);
		String Weather;
		System.out.println("How is the weather?:");
		System.out.println("Sunny");
		System.out.println("Raining");
		System.out.println("Other");

		weather = read.next();

		if (weather.equalsIgnoreCase("sunny")){
			System.out.println("Take the Umbrella!!");
		} else if(weather.equalsIgnoreCase("raining")){
			System.out.println("Take the Big Umbrella!!");
		} else {
			System.out.println("Take the umbrella also!!");


		}

		weather.close();



	}


}
